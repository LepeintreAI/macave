rix)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6effa;strokeColor=#4a6fa5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="460" width="250" height="44" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A2" target="U5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="U6" value="Déplacer une bouteille" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6effa;strokeColor=#4a6fa5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="512" width="250" height="44" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A2" target="U6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="U7" value="Retirer une bouteille" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6effa;strokeColor=#4a6fa5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="564" width="250" height="44" as="geometry"/></mxCell><mxCell id="e10" value="" style="endArrow=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A2" target="U7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="U8" value="Archiver une bouteille" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6effa;strokeColor=#4a6fa5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="616" width="250" height="44" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A2" target="U8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="U9" value="Modifier son évaluation" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6effa;strokeColor=#4a6fa5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="668" width="250" height="44" as="geometry"/></mxCell><mxCell id="e12" value="" style="endArrow=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent=